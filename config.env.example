# Configuration for Daily AI News Automation Email Dispatch
# Copy this file to config.env and fill in your values

# SMTP Configuration
# For Outlook / Office 365:
#   SMTP_SERVER=smtp.office365.com
#   SMTP_PORT=587
# For FTPI Mail Server (Internal):
#   SMTP_SERVER=mail.ftpi.or.th (or your company SMTP server)
#   SMTP_PORT=587 (or 465 for SSL)

SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
USE_TLS=True

# Sender credentials (your FTPI / Outlook email and password or App Password)
SENDER_EMAIL=your_email@domain.com
SENDER_PASSWORD=your_password_or_app_password

# Recipient email address
RECIPIENT_EMAIL=recipient_email@domain.com

# Gemini API Key for translation and content generation
GEMINI_API_KEY=your_gemini_api_key_here
